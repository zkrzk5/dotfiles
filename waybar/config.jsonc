{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "idle_inhibitor",
        "memory",
        "cpu",
        "bluetooth",
        "network",
        "pulseaudio",
        "custom/power-profile",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true
    },

    "mpris": {
        "format": "{title}",
        "format-paused": "\uf04c {title}",
        "max-length": 25
    },

    "clock": {
        "format": "\uf017 {:%I:%M %p}",
        "format-alt": "\uf133 {:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "mode",
        "calendar": {
            "format": {
                "today": "<span color='#d8a657'><b>{}</b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "idle_inhibitor": {
        "format": "\uf0f4",
        "tooltip": false
    },

    "memory": {
        "format": "\uf1c0 {percentage}%",
        "on-click": "kitty -e btop"
    },
    "cpu": {
        "format": "\uf2db {usage}%",
        "on-click": "kitty -e btop"
    },

    "custom/power-profile": {
"exec": "~/.config/waybar/scripts/power-profile.sh",
"return-type": "json",
"interval": 5,
"on-click": "~/.config/waybar/scripts/power-profile.sh --cycle",
"tooltip": true
},

    "bluetooth": {
    "format": "\uf293",
    "format-disabled": "\uf294",
    "format-connected": "\uf293 {device_alias}",
    "on-click": "~/.config/waybar/scripts/bt-toggle.sh"
},

    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf6ff",
        "format-disconnected": "\uf127",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026",
        "format-icons": { "default": ["\uf027", "\uf028"] },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    }
}