{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "38;2;142;192;124",
      "2": "38;2;142;192;124"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰁔 "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;142;192;124",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "os",
      "key": "󰣇 os  ",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "󰒍 ker ",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󱎫 upt ",
      "keyColor": "38;2;142;192;124"
    },
    {
      "type": "wm",
      "key": "󰧨 wm  ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰞷 sh  ",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "󰆍 term",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "󰍛 mem ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}